---
import Layout from '../components/Layout.astro';
import PosterBoard from '../components/PosterBoard.astro';
import Rows from '../components/Rows.astro';
import { posts } from '../lib/content';
---

<Layout>
  <div class="mast">
    <div>
      <p class="byline">AI-native developer</p><h1>
        Mooyeon Choi<span>.</span>
      </h1>
    </div><p class="mast-copy">
      AI와 함께 일하며,<br /> 더 사용해보고 싶은 인터페이스를 만듭니다.
    </p>
  </div>
  <PosterBoard />
  <section class="journal">
    <div class="section-head">
      <h2>최근 기록</h2><a href="/writing">기록 보기 →</a>
    </div><Rows items={posts.slice(0, 4)} />
  </section>
</Layout>
